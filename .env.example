# Copy to .env and adjust. .env is gitignored.
# Every path is read through config — nothing is hardcoded, so the same code runs
# locally and on Kaggle unchanged (decision PF-1 makes this a hard requirement).

# ── Storage ──────────────────────────────────────────────────────────────────
# Keep everything off C:. LAV-DF is 25.6 GB and the working set peaks at ~45-55 GB.
AVTFD_DATA_ROOT=D:/Audio-Visual Temporal Forgery Detection & Localization/data
AVTFD_EXPERIMENTS_ROOT=D:/Audio-Visual Temporal Forgery Detection & Localization/experiments
AVTFD_CHECKPOINTS_ROOT=D:/Audio-Visual Temporal Forgery Detection & Localization/checkpoints

# On Kaggle these become:
#   AVTFD_DATA_ROOT=/kaggle/input/lavdf-features
#   AVTFD_EXPERIMENTS_ROOT=/kaggle/working/experiments

# ── Experiment tracking ──────────────────────────────────────────────────────
# Local file-backed MLflow — no account, no network, run store is just files.
MLFLOW_TRACKING_URI=file:./mlruns

# ── Compute ──────────────────────────────────────────────────────────────────
AVTFD_DEVICE=auto          # auto | cuda | cpu
AVTFD_NUM_WORKERS=2        # never 8 — each worker holds decoded frame buffers (§12.2)
AVTFD_PIN_MEMORY=false     # false on a 6 GB machine

# ── API (Phase 13) ───────────────────────────────────────────────────────────
AVTFD_API_HOST=127.0.0.1
AVTFD_API_PORT=8000
AVTFD_MAX_UPLOAD_MB=200
AVTFD_MAX_CONCURRENT_JOBS=1   # 6 GB RAM cannot support more; enforced by semaphore
AVTFD_JOB_TIMEOUT_S=300
